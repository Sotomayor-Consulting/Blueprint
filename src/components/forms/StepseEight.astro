---
import Bolt from "@tabler/icons/filled/bolt.svg";
import BuildingBank from "@tabler/icons/outline/building-bank.svg";
import { Image } from "astro:assets";

import MemberManaged from "@/assets/images/member-managed-admin.webp";
import ManagerManaged from "@/assets/images/manager-managed-admin.webp";
import { Badge } from "@/components/starwind/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import { FieldGroup, FieldSet } from "@/components/starwind/field";
import { RadioGroup, RadioGroupItem } from "@/components/starwind/radio-group";

const sistemModels = [
  {
    id: "Member-Managed",
    value: "Member-Managed",
    name: "Member-Managed",
    description:
      "En una LLC Member-Managed, los socios son responsables de administrar la compañía y pueden ejercer facultades de representación conforme al Operating Agreement y la legislación aplicable.",
    adventage:
      "Los propietarios mantienen el control directo de la administración y las decisiones empresariales.",
    image: MemberManaged,
  },
  {
    id: "Manager-Managed",
    value: "Manager-Managed",
    name: "Manager-Managed",
    description:
      "En una LLC Manager-Managed, la administración se delega a uno o varios Managers, quienes pueden ser socios o personas externas. Los propietarios conservan sus derechos societarios, pero delegan la gestión de la compañía conforme al Operating Agreement.",
    adventage:
      "Permite separar la propiedad de la administración y designar a una persona específica para dirigir y representar la empresa.",
    image: ManagerManaged,
  },
];

const defaultModel = sistemModels[0];
---

<Card class="w-full px-5 py-10 shadow-2xl">
  <CardHeader class="gap-y-5">
    <Badge
      tone="primary-accent"
      appearance="outline"
      size="sm"
      class="w-fit p-1"
      eyebrow
    >
      <Bolt /> MODELO · SISTEMA ADMINISTRATIVO
    </Badge>
    <CardTitle class="text-4xl"
      >¿Quién administrará y representará la LLC?</CardTitle
    >
    <CardDescription class="text-xl">
      La LLC puede ser administrada directamente por sus socios (Members) o por
      uno o varios administradores designados (Managers). Esta decisión
      determina quién tendrá autoridad para dirigir la empresa y actuar en su
      nombre.
    </CardDescription>
  </CardHeader>

  <CardContent class="mt-5">
    <FieldGroup>
      <FieldSet>
        <div>
          <RadioGroup
            id="sistem-model-group"
            name="sistemModel"
            legend="Selecciona el modelo principal de la LLC"
            defaultValue={defaultModel.value}
            required
            aria-describedby="sistem-model-error"
            class="grid grid-cols-1 gap-4 pt-2 md:grid-cols-2"
          >
            {
              sistemModels.map((model) => {
                return (
                  <div
                    data-sistem-model-option
                    data-value={model.value}
                    data-label={model.name}
                    class="group/model focus-within:ring-outline/50 has-data-checked:ring-primary relative block cursor-pointer rounded-xl transition-shadow duration-200 focus-within:ring-3 has-data-checked:ring-3 motion-reduce:transition-none"
                  >
                    <RadioGroupItem
                      id={model.id}
                      value={model.value}
                      aria-label={model.name}
                      variant="primary"
                      nativeButton
                      wrapperClass="absolute inset-0 z-20 size-full group-data-[size=sm]/radio-group:size-full group-data-[size=md]/radio-group:size-full group-data-[size=lg]/radio-group:size-full"
                      rootClass="rounded-xl"
                      class="inset-auto top-4 right-4 size-5 bg-background/90 shadow-sm backdrop-blur-sm"
                    />

                    <Card class="h-full gap-0 overflow-hidden py-0 transition-shadow group-hover/model:shadow-lg">
                      <CardHeader class="pb-5">
                        <div class="bg-primary-accent/30 mt-6 inline-flex w-fit rounded-xl p-2">
                          <Image
                            class="text-primary size-6"
                            aria-hidden="true"
                            alt={`Imagen de ${model.name}`}
                            src={model.image}
                          />
                        </div>
                        <CardTitle class="text-base">{model.name}</CardTitle>
                        <CardDescription class="text-sm">
                          {model.description}
                          <div class="flex flex-col gap-1 mt-2">
                            <Badge
                              tone="primary-accent"
                              appearance="text"
                              size="sm"
                              class="w-fit p-1"
                              eyebrow
                            >
                              Ventaja Principal
                            </Badge>
                            <div>{model.adventage}</div>
                          </div>
                        </CardDescription>
                      </CardHeader>
                    </Card>
                  </div>
                );
              })
            }
          </RadioGroup>

          <p
            id="sistem-model-error"
            class="text-error text-sm"
            role="alert"
            hidden
          >
            Selecciona un sistema administrativo para continuar.
          </p>
        </div>
      </FieldSet>

      
    </FieldGroup>
  </CardContent>
</Card>
