---
import Bolt from "@tabler/icons/filled/bolt.svg";
import BuildingBank from "@tabler/icons/outline/building-bank.svg";

import Nulaimg from "@/assets/images/nula.webp";
import Parcialimg from "@/assets/images/parcial.webp";
import Totalimg from "@/assets/images/total.webp";
import { Image } from "astro:assets";
import { Icon } from 'astro-icon/components'
import { Badge } from "@/components/starwind/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "@/components/starwind/alert";
import {
  FieldDescription,
  FieldGroup,
  FieldLegend,
  FieldSet,
} from "@/components/starwind/field";
import { RadioGroup, RadioGroupItem } from "@/components/starwind/radio-group";

const confidencialidad = [
  {
    id: "Nula",
    value: "Nula",
    name: "Nula",
    description: "Los socios se reflejan en el registro estatal.",
    image: Nulaimg,
  },
  {
    id: "Parcial",
    value: "Parcial",
    name: "Parcial",
    description: "Los socios se reflejan en el registro estatal.",
    image: Parcialimg,
  },
  {
    id: "Total",
    value: "Total",
    name: "Total",
    description: "Los socios no se reflejan en el reqistro estatal.",
    image: Totalimg,
  },
];

const defaultLevel = confidencialidad[0];
---

<Card class="w-full px-5 py-10 shadow-2xl">
  <CardHeader class="gap-y-5">
    <Badge
      tone="primary-accent"
      appearance="outline"
      size="sm"
      class="w-fit p-1"
      eyebrow
    >
      <Bolt /> CONFIDENCIALIDAD
    </Badge>
    <CardTitle class="text-4xl">Confidencialidad registral</CardTitle>
    <CardDescription class="text-xl">
      Define qué información de socios y managers puede aparecer en el registro
      estatal.
    </CardDescription>
  </CardHeader>

  <CardContent class="mt-5">
    <FieldGroup>
      <FieldSet>
        <FieldLegend>Selecciona un nivel de confidencialidad</FieldLegend>
        <FieldDescription>
          Selecciona el nivel que mejor se ajuste a tus necesidades.
        </FieldDescription>

        <Alert variant="info">
          <AlertTitle class="text-lg">
            <Icon name="MingcuteInformationFill" />
          </AlertTitle>
          <AlertDescription class="text-sm">
            La confidencialidad registral es importante porque determina si la información de los socios y de la administración de la empresa será visible públicamente en el registro estatal. Elegir el nivel adecuado permite proteger la privacidad de los propietarios, reducir la exposición de su información personal y alinearse con los objetivos de la estructura societaria.
          </AlertDescription>
        </Alert>

        <div>
          <RadioGroup
            id="confidentiality-level-group"
            name="confidentialityLevel"
            legend="Selecciona el nivel de confidencialidad"
            defaultValue={defaultLevel.value}
            required
            aria-describedby="confidentiality-level-error"
            class="grid grid-cols-1 gap-4 pt-2 md:grid-cols-3"
          >
            {
              confidencialidad.map((model) => {
                return (
                  <div
                    data-confidentiality-option
                    data-value={model.value}
                    data-label={model.name}
                    class="group/model focus-within:ring-outline/50 has-data-checked:ring-primary relative block cursor-pointer rounded-xl transition-shadow duration-200 focus-within:ring-3 has-data-checked:ring-3 motion-reduce:transition-none"
                  >
                    <RadioGroupItem
                      id={model.id}
                      value={model.value}
                      aria-label={model.name}
                      variant="primary"
                      nativeButton
                      wrapperClass="absolute inset-0 z-20 size-full group-data-[size=sm]/radio-group:size-full group-data-[size=md]/radio-group:size-full group-data-[size=lg]/radio-group:size-full"
                      rootClass="rounded-xl"
                      class="inset-auto top-4 right-4 size-5 bg-background/90 shadow-sm backdrop-blur-sm"
                    />

                    <Card class="h-full gap-0 overflow-hidden py-0 transition-shadow group-hover/model:shadow-lg">
                      <CardHeader class="py-5 grid-cols-[auto_1fr] grid-rows-1 h-full">
                        <div class="w-fit rounded-xl p-2 mr-5 flex items-center justify-center h-full">
                          <Image
                            src={model.image}
                            alt={model.name}
                            class="text-primary size-15"
                          />
                        </div>
                        <div>
                          <CardTitle class="text-base">{model.name}</CardTitle>
                          <CardDescription class="text-sm">
                            {model.description}
                          </CardDescription>
                        </div>
                      </CardHeader>
                    </Card>
                  </div>
                );
              })
            }
          </RadioGroup>

          <p
            id="confidentiality-level-error"
            class="text-error text-sm"
            role="alert"
            hidden
          >
            Selecciona un nivel de confidencialidad para continuar.
          </p>
        </div>
      </FieldSet>

      <Card
        class="bg-primary-accent/5 ring-primary-accent/20"
        aria-live="polite"
      >
        <CardContent class="flex items-center gap-4">
          <span
            class="bg-primary-accent/10 text-primary-accent grid size-11 shrink-0 place-items-center rounded-full"
          >
            <BuildingBank class="size-5" aria-hidden="true" />
          </span>
          <div class="min-w-0">
            <p class="text-muted-foreground text-sm">Modelo seleccionado</p>
            <p
              class="text-foreground truncate text-lg font-semibold"
              data-selected-confidentiality
            >
              {defaultLevel.name}
            </p>
          </div>
        </CardContent>
      </Card>
    </FieldGroup>
  </CardContent>
</Card>

<script>
  import {
    readFormDraft,
    updateFormDraft,
    type ConfidentialityLevel,
  } from "./form-draft";

  const isConfidentialityLevel = (
    value: string,
  ): value is ConfidentialityLevel =>
    value === "Nula" || value === "Parcial" || value === "Total";

  const publishConfidentiality = (
    root: HTMLElement,
    value: ConfidentialityLevel,
  ) => {
    updateFormDraft({ confidentialityLevel: value });
    root.dispatchEvent(
      new CustomEvent("llc-form:confidentiality-change", {
        bubbles: true,
        detail: { value },
      }),
    );
  };

  const setupConfidentialitySelector = (root: HTMLElement) => {
    if (root.dataset.confidentialityReady === "true") return;
    root.dataset.confidentialityReady = "true";

    const output = root
      .closest<HTMLElement>('[data-slot="card"]')
      ?.querySelector<HTMLElement>("[data-selected-confidentiality]");
    const options = Array.from(
      root.querySelectorAll<HTMLElement>("[data-confidentiality-option]"),
    );

    root.addEventListener("starwind:value-change", (event) => {
      const { value } = (event as CustomEvent<{ value: string }>).detail;
      const selected = options.find((option) => option.dataset.value === value);

      if (output && selected?.dataset.label) {
        output.textContent = selected.dataset.label;
      }

      if (isConfidentialityLevel(value)) publishConfidentiality(root, value);
    });

    root.closest("form")?.addEventListener("llc-form:reset", () => {
      if (output)
        output.textContent = "Nula - Revela a los Socios y al Manager";
      publishConfidentiality(root, "Nula");
    });
  };

  const restoreConfidentiality = (root: HTMLElement) => {
    if (root.dataset.confidentialityRestored === "true") return;
    root.dataset.confidentialityRestored = "true";

    const storedValue = readFormDraft().answers.confidentialityLevel;
    const currentValue = root.dataset.value;

    if (
      storedValue &&
      isConfidentialityLevel(storedValue) &&
      storedValue !== currentValue
    ) {
      const storedOption = Array.from(
        root.querySelectorAll<HTMLElement>("[data-confidentiality-option]"),
      ).find((option) => option.dataset.value === storedValue);
      storedOption
        ?.querySelector<HTMLElement>('[data-slot="radio-group-item"]')
        ?.click();
      return;
    }

    if (currentValue && isConfidentialityLevel(currentValue)) {
      publishConfidentiality(root, currentValue);
    }
  };

  const initConfidentialitySelectors = () => {
    document
      .querySelectorAll<HTMLElement>("#confidentiality-level-group")
      .forEach((root) => {
        setupConfidentialitySelector(root);
        requestAnimationFrame(() => restoreConfidentiality(root));
      });
  };

  initConfidentialitySelectors();
  document.addEventListener("astro:page-load", initConfidentialitySelectors);
</script>
