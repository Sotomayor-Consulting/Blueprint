---
import { Form } from "@/components/starwind/form";
import { Badge } from "@/components/starwind/badge";
import {
  Field,
  FieldControl,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@/components/starwind/field";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "@/components/starwind/alert";


import CardRotate from "@components/blocks/Card.astro";
import IconPalette from "@tabler/icons/outline/user-search.svg";
import Bolt from "@tabler/icons/filled/bolt.svg";
---

<Card class="w-full shadow-2xl px-5 py-10">
  <CardHeader class="gap-y-5">
    <Badge
      tone="primary-accent"
      appearance="outline"
      size="md"
      class="p-1 w-fit"
      eyebrow
    >
      <Bolt /> PASO INICIAL · DISEÑO ESTRATÉGICO</Badge
    >
    <CardTitle class="text-6xl">Iniciemos el Diseño Estratégico</CardTitle>
    <CardDescription class="text-2xl"
      >Partimos de los datos del cliente para ordenar el diagnóstico y definir
      la estructura de la LLC.</CardDescription
    >
  </CardHeader>
  <Form
    validationTiming="manual"
    revalidationTiming="manual"
    errorVisibility="manual"
  >
    <CardContent class="flex gap-4 mt-5">
      <CardRotate class="bg-card w-full max-w-md rounded-2xl p-8">
        <div class="text-center">
          <div
            class="bg-primary-accent/10 mx-auto mb-6 inline-flex rounded-xl p-4"
          >
            <IconPalette
              class="text-primary-accent size-8"
              aria-hidden="true"
            />
          </div>
          <h3 class="font-heading mb-3 text-xl font-semibold">
            Buscar expediente del cliente
          </h3>
          <p class="text-neutral-800 text-sm leading-relaxed">
            Coloca el correo del cliente para consultar y recuperar sus datos
            registrados en el sistema.
          </p>
        </div>
      </CardRotate>
      <div class="w-full flex h-full flex-col gap-y-4">
        <FieldGroup class="w-full">
          <Field name="email">
            <FieldLabel>Email</FieldLabel>
            <FieldControl
              id="email"
              name="email"
              type="email"
              class="border-primary h-15"
              autocomplete="email"
              placeholder="tu@email.com"
              required
            />
            <FieldDescription>Correo electrónico del cliente</FieldDescription>
            <FieldError match="valueMissing"
              >Escribe un correo electrónico.</FieldError
            >
            <FieldError match="typeMismatch">Usa un correo válido.</FieldError>
          </Field>
          
        </FieldGroup>
        <Alert variant="info">
          <AlertTitle>¡Tip!</AlertTitle>
          <AlertDescription>
            Si el correo ingresado no está registrado en el sistema, no te
            preocupes: se añadirá automáticamente un nuevo contacto en Odoo.
          </AlertDescription>
        </Alert>
      </div>
    </CardContent>
  </Form>
</Card>
