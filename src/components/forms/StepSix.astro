];

const indicadoresOperativos = [
  {
    title: "Oficina, local o bodega",
    description: "Presencia Fisica",
    id: "oficina-local-bodega",
    icon: "MaterialSymbolsLightLocalMallSharp",
  },
  {
    title: "Inventario en EE. UU.",
    description: "Stock o fulfillment",
    id: "Inventario-en-EEUU",
    icon: "MaterialSymbolsLightLocalMallSharp",
  },
  {
    title: "Servicios ejecutados en EE. UU.",
    description: "Trabajo presencial",
    id: "Servicios-ejecutados-en-EEUU",
    icon: "MaterialSymbolsLightDesignServices",
  },
  {
    title: "Empleados en EE. UU.",
