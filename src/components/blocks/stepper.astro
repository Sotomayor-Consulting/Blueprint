---
import ArrowLeft from "@tabler/icons/outline/arrow-left.svg";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Check from "@tabler/icons/outline/check.svg";
import { Button } from "@/components/starwind/button";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/starwind/tabs";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

export interface StepperStep {
  id: string;
  title: string;
  description?: string;
  disabled?: boolean;
}

interface Props
  extends Omit<HTMLAttributes<"div">, "defaultValue" | "onChange" | "value"> {
  steps: StepperStep[];
  defaultValue?: string;
  orientation?: "horizontal" | "vertical";
  syncKey?: string;
  showNavigation?: boolean;
  validateOnAdvance?: boolean;
  label?: string;
  backLabel?: string;
  nextLabel?: string;
  finishLabel?: string;
}

const {
  steps,
  defaultValue,
  orientation = "vertical",
  syncKey,
  showNavigation = true,
  validateOnAdvance = true,
  label = "Steps",
  backLabel = "Back",
  nextLabel = "Next",
  finishLabel = "Finish",
  class: className,
  ...rest
} = Astro.props;

const stepper = tv({ base: "min-w-0 w-full" });

const stepperList = tv({
  base: "w-full items-stretch justify-start bg-transparent p-0",
  variants: {
    orientation: {
      vertical: "flex-col",
      horizontal: [
        "flex-row overflow-x-auto overscroll-x-contain scroll-smooth pb-3",
        "snap-x snap-mandatory [scrollbar-width:thin]",
        "[&::-webkit-scrollbar]:h-1.5 [&::-webkit-scrollbar-thumb]:rounded-full",
        "[&::-webkit-scrollbar-thumb]:bg-border [&::-webkit-scrollbar-track]:bg-transparent",
      ],
    },
  },
  defaultVariants: { orientation: "vertical" },
});

const stepperTrigger = tv({
  base: [
    "group/step relative grow-0 rounded-md border-0 bg-transparent py-0 font-normal whitespace-normal",
    "text-muted-foreground data-[state=active]:bg-transparent data-[state=active]:text-foreground data-[state=active]:shadow-none",
    "dark:data-[state=active]:border-0 dark:data-[state=active]:bg-transparent dark:data-[state=active]:text-foreground",
  ],
  variants: {
    orientation: {
      vertical: "w-full flex-row items-start justify-start gap-3 px-0 py-3",
      horizontal: [
        "w-36 flex-none snap-start flex-col items-start justify-start gap-2 px-2",
        "sm:w-40 lg:w-44",
      ],
    },
  },
  defaultVariants: { orientation: "vertical" },
});

const stepperConnector = tv({
  base: "pointer-events-none absolute bg-border transition-colors data-[completed]:bg-primary",
  variants: {
    orientation: {
      vertical: "top-[2.875rem] -bottom-3 left-4 w-px",
      horizontal: "top-4 -right-3 left-[2.75rem] h-px",
    },
  },
  defaultVariants: { orientation: "vertical" },
});

const stepperMarker = tv({
  base: [
    "flex size-8 shrink-0 items-center justify-center rounded-full border text-xs font-medium transition-colors",
    "border-border bg-muted text-muted-foreground",
    "group-data-[state=active]/step:border-primary group-data-[state=active]/step:bg-primary group-data-[state=active]/step:text-primary-foreground",
    "group-data-[completed]/step:border-primary group-data-[completed]/step:bg-primary group-data-[completed]/step:text-primary-foreground",
  ],
});

const stepperText = tv({
  base: "flex min-w-0 flex-1 flex-col gap-1",
  variants: {
    orientation: {
      vertical: "items-start text-left",
      horizontal: "items-start text-left",
    },
  },
  defaultVariants: { orientation: "vertical" },
});

const stepperTitle = tv({
  base: "text-xs font-medium leading-4",
  variants: {
    orientation: {
      vertical: "",
      horizontal: "line-clamp-2 min-h-8",
    },
  },
  defaultVariants: { orientation: "vertical" },
});

const stepperPanel = tv({ base: "mt-5" });
---

<Tabs
  class={stepper({ class: className })}
  defaultValue={defaultValue ?? steps[0]?.id}
  orientation={orientation}
  syncKey={syncKey}
  data-stepper
  data-stepper-orientation={orientation}
  data-stepper-validate={validateOnAdvance ? "" : undefined}
  {...rest}
>
  <TabsList
    class={stepperList({ orientation })}
    aria-label={label}
    data-stepper-list
  >
    {
      steps.map((step, index) => (
        <TabsTrigger
          value={step.id}
          disabled={step.disabled}
          data-stepper-index={index}
          class={stepperTrigger({ orientation })}
        >
          {index < steps.length - 1 && (
            <span
              class={stepperConnector({ orientation })}
              data-stepper-connector
              aria-hidden="true"
            />
          )}

          <span class={stepperMarker()}>
            <span class="inline-flex group-data-[completed]/step:hidden">{index + 1}</span>
            <Check class="hidden size-4 group-data-[completed]/step:inline-flex" />
          </span>

          <span class={stepperText({ orientation })}>
            <span class={stepperTitle({ orientation })}>
              {step.title}
            </span>
            {step.description && (
              <span class="text-muted-foreground line-clamp-2 text-xs">
                {step.description}
              </span>
            )}
          </span>
        </TabsTrigger>
      ))
    }
  </TabsList>

  {
    steps.map((step) => (
      <TabsContent value={step.id} class={stepperPanel()}>
        {Astro.slots.has(step.id) ? <slot name={step.id} /> : <slot />}
      </TabsContent>
    ))
  }

  {
    showNavigation && (
      <div class="mt-6 grid grid-cols-2 gap-2 border-t pt-4 sm:flex sm:items-center sm:justify-between">
        <Button
          type="button"
          variant="outline"
          size="sm"
          class="w-full sm:w-auto"
          data-stepper-prev
        >
          <ArrowLeft />
          {backLabel}
        </Button>

        <Button
          type="button"
          variant="primary"
          size="sm"
          class="w-full sm:w-auto"
          data-stepper-next
        >
          <span data-stepper-next-label>{nextLabel}</span>
          <span data-stepper-finish-label class="hidden">
            {finishLabel}
          </span>
          <ArrowRight />
        </Button>
      </div>
    )
  }
</Tabs>

<script>
  const setupResponsiveStepper = (root: HTMLElement) => {
    if (
      root.dataset.stepperResponsiveReady === "true" ||
      root.dataset.stepperOrientation !== "horizontal"
    )
      return;

    root.dataset.stepperResponsiveReady = "true";

    const list = root.querySelector<HTMLElement>("[data-stepper-list]");
    if (!list) return;

    const activeTrigger = () =>
      list.querySelector<HTMLElement>(
        '[data-slot="tabs-trigger"][data-state="active"]',
      );

    const revealActiveStep = (behavior: ScrollBehavior = "smooth") => {
      const trigger = activeTrigger();
      if (!trigger) return;

      const listRect = list.getBoundingClientRect();
      const triggerRect = trigger.getBoundingClientRect();
      const fullyVisible =
        triggerRect.left >= listRect.left && triggerRect.right <= listRect.right;

      if (fullyVisible) return;

      const left =
        list.scrollLeft +
        triggerRect.left -
        listRect.left -
        (list.clientWidth - trigger.clientWidth) / 2;

      list.scrollTo({ behavior, left: Math.max(0, left) });
    };

    root.addEventListener("starwind:value-change", (event) => {
      if (event.target !== root) return;
      requestAnimationFrame(() => revealActiveStep());
    });

    const resizeObserver = new ResizeObserver(() => revealActiveStep("auto"));
    resizeObserver.observe(list);

    requestAnimationFrame(() => revealActiveStep("auto"));
  };

  const initResponsiveSteppers = () => {
    document
      .querySelectorAll<HTMLElement>("[data-stepper]")
      .forEach(setupResponsiveStepper);
  };

  initResponsiveSteppers();
  document.addEventListener("astro:page-load", initResponsiveSteppers);
</script>
