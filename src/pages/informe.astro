---
import ReportTemplate from "@/components/report/ReportTemplate.astro";
import "@fontsource/blinker/400.css";
import "@fontsource/blinker/600.css";
import "@fontsource/blinker/700.css";
import "@fontsource/blinker/800.css";
import "@/styles/report.css";

const homeUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <meta
      name="description"
      content="Vista previa del informe condicional de planificación de LLC."
    />
    <title>Informe de planificación estratégica y diseño legal y tributario de la LLC</title>
  </head>
  <body>
    <header class="report-toolbar" data-report-toolbar>
      <div class="report-toolbar__copy">
        <strong>Vista previa del informe</strong>
        <span>Prototipo generado en este navegador</span>
      </div>
      <nav class="report-toolbar__actions" aria-label="Acciones del informe">
        <a class="report-button" href={homeUrl}>Editar respuestas</a>
        <button
          class="report-button report-button--primary"
          type="button"
          data-download-report
          disabled
        >
          Descargar PDF
        </button>
        <button
          class="report-button report-button--complete"
          type="button"
          data-complete-report
        >
          Completar
        </button>
      </nav>
    </header>

    <main class="report-page-shell">
      <section class="report-status" data-report-loading aria-live="polite">
        Preparando la vista previa…
      </section>

      <section class="report-empty" data-report-empty hidden>
        <h1>No hay respuestas para generar el informe</h1>
        <p>
          Completa el formulario y pulsa <strong>Finalizar</strong> para crear
          una vista previa condicional.
        </p>
        <a class="report-button report-button--primary" href={homeUrl}>
          Ir al formulario
        </a>
      </section>

      <div class="report-preview">
        <ReportTemplate />
      </div>

      <p
        class="report-download-message"
        data-download-message
        role="status"
        aria-live="polite"
      ></p>
    </main>

    <script>
      import {
        clearFormDraft,
        readFormDraft,
      } from "@/components/forms/form-draft";
      import { deriveReportFacts } from "@/lib/report/facts";
      import {
        buildReportModel,
        type ReportBlock,
        type ReportSection,
        type ReportSubsection,
        type ReportTable,
      } from "@/lib/report/model";
      import { normalizeAnswers } from "@/lib/report/normalize";

      const report = document.querySelector<HTMLElement>("[data-report]");
      const loading = document.querySelector<HTMLElement>(
        "[data-report-loading]",
      );
      const empty = document.querySelector<HTMLElement>("[data-report-empty]");
      const downloadButton = document.querySelector<HTMLButtonElement>(
        "[data-download-report]",
      );
      const completeButton = document.querySelector<HTMLButtonElement>(
        "[data-complete-report]",
      );
      const downloadMessage = document.querySelector<HTMLElement>(
        "[data-download-message]",
      );

      const setText = (selector: string, value: string) => {
        const target = report?.querySelector<HTMLElement>(selector);
        if (target) target.textContent = value;
      };

      const element = <Tag extends keyof HTMLElementTagNameMap>(
        tag: Tag,
        className?: string,
        text?: string,
      ) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      };

      const renderTable = (tableModel: ReportTable) => {
        const wrapper = element("div", "report-table-wrap report-block");
        const table = element("table", "report-table");
        const head = element("thead");
        const headerRow = element("tr");
        tableModel.headers.forEach((header) => {
          const cell = element("th", undefined, header);
          cell.scope = "col";
          headerRow.append(cell);
        });
        head.append(headerRow);

        const body = element("tbody");
        tableModel.rows.forEach((row) => {
          const tableRow = element("tr", "report-table-row");
          row.forEach((value, index) => {
            const cell = element("td");
            if (index === 0) cell.className = "report-table__label";

            if (typeof value === "string") {
              cell.textContent = value;
            } else {
              const list = element("ul", "report-table-list");
              value.items.forEach((item) =>
                list.append(element("li", undefined, item)),
              );
              cell.append(list);
            }

            tableRow.append(cell);
          });
          body.append(tableRow);
        });

        table.append(head, body);
        wrapper.append(table);
        return wrapper;
      };

      const renderBlock = (block: ReportBlock) => {
        if (block.kind === "table") return renderTable(block.table);

        if (block.kind === "list") {
          const list = element("ul", "report-list");
          block.items.forEach((item) =>
            list.append(element("li", undefined, item)),
          );
          return list;
        }

        if (block.kind === "selected") {
          const selected = element("div", "report-selected report-block");
          selected.append(
            element("span", "report-selected__label", block.label),
            element("strong", "report-selected__value", block.value),
          );
          return selected;
        }

        if (block.kind === "note") {
          const note = element("aside", "report-note report-block");
          if (block.title) {
            note.append(element("strong", "report-note__title", block.title));
          }
          note.append(element("p", "report-note__text", block.text));
          return note;
        }

        const paragraph = element("p", "report-paragraph");
        if (block.label) {
          paragraph.append(
            element("strong", undefined, `${block.label}: `),
          );
        }
        paragraph.append(document.createTextNode(block.text));
        return paragraph;
      };

      const renderSubsection = (
        subsection: ReportSubsection,
        flowUnit = true,
      ) => {
        const subsectionElement = element(
          "section",
          flowUnit
            ? "report-subsection report-flow-unit"
            : "report-subsection",
        );
        subsectionElement.dataset.subsection = subsection.id;
        subsectionElement.append(element("h3", undefined, subsection.title));
        subsection.blocks.forEach((block) =>
          subsectionElement.append(renderBlock(block)),
        );
        return subsectionElement;
      };

      const renderSectionUnits = (section: ReportSection) => {
        const units: HTMLElement[] = [];
        const opener = element(
          "section",
          "report-chapter report-flow-unit",
        );
        opener.dataset.section = section.id;
        opener.append(element("h2", undefined, section.title));

        if (section.introduction) {
          opener.append(
            element(
              "p",
              "report-chapter__introduction",
              section.introduction,
            ),
          );
        }

        const [firstSubsection, ...remainingSubsections] =
          section.subsections ?? [];
        if (firstSubsection) {
          opener.append(renderSubsection(firstSubsection, false));
        }
        section.blocks?.forEach((block) => opener.append(renderBlock(block)));
        units.push(opener);

        remainingSubsections.forEach((subsection) =>
          units.push(renderSubsection(subsection)),
        );

        return units;
      };

      const createBodyPage = (pages: HTMLElement, pageNumber: number) => {
        const page = element("section", "report-page report-body-page");
        page.dataset.reportPage = String(pageNumber);
        page.setAttribute("aria-label", `Página ${pageNumber} del informe`);
        const content = element("div", "report-page__content");
        page.append(content);
        pages.append(page);
        return content;
      };

      const paginateFlowUnits = (
        pages: HTMLElement,
        units: HTMLElement[],
      ) => {
        pages.replaceChildren();
        let pageNumber = 2;
        let content = createBodyPage(pages, pageNumber);

        units.forEach((unit) => {
          content.append(unit);
          const overflows = content.scrollHeight > content.clientHeight + 1;
          if (!overflows || content.childElementCount === 1) {
            if (overflows) {
              unit.dataset.pageOverflow = "true";
              console.warn(
                "Un bloque del informe supera una página A4.",
                unit,
              );
            }
            return;
          }

          unit.remove();
          pageNumber += 1;
          content = createBodyPage(pages, pageNumber);
          content.append(unit);

          if (content.scrollHeight > content.clientHeight + 1) {
            unit.dataset.pageOverflow = "true";
            console.warn(
              "Un bloque del informe supera una página A4.",
              unit,
            );
          }
        });
      };

      const sanitizePdfClone = (clonedDocument: Document) => {
        const clonedReport = clonedDocument.querySelector<HTMLElement>(
          "[data-report]",
        );
        const clonedWindow = clonedDocument.defaultView;
        if (!clonedReport || !clonedWindow) return;

        const canvas = clonedDocument.createElement("canvas");
        canvas.width = 1;
        canvas.height = 1;
        const context = canvas.getContext("2d", { willReadFrequently: true });
        if (!context) return;

        const colorCache = new Map<string, string>();
        const toRgba = (value: string) => {
          const cached = colorCache.get(value);
          if (cached) return cached;

          context.clearRect(0, 0, 1, 1);
          context.fillStyle = "#000000";
          context.fillStyle = value;
          context.fillRect(0, 0, 1, 1);
          const [red, green, blue, alpha] = context.getImageData(
            0,
            0,
            1,
            1,
          ).data;
          const converted = `rgba(${red}, ${green}, ${blue}, ${alpha / 255})`;
          colorCache.set(value, converted);
          return converted;
        };

        const colorProperties = [
          "color",
          "background-color",
          "border-top-color",
          "border-right-color",
          "border-bottom-color",
          "border-left-color",
          "outline-color",
          "text-decoration-color",
          "-webkit-text-stroke-color",
          "caret-color",
          "column-rule-color",
          "fill",
          "stroke",
        ];

        clonedReport.style.boxShadow = "none";
        clonedReport.style.margin = "0";
        clonedReport.classList.add("report-document--pdf");
        clonedReport
          .querySelectorAll<HTMLElement>(".report-page")
          .forEach((page) => {
            page.style.setProperty("margin", "0", "important");
            page.style.setProperty("box-shadow", "none", "important");
          });

        clonedDocument
          .querySelectorAll<HTMLElement>("*")
          .forEach((element) => {
            const computed = clonedWindow.getComputedStyle(element);
            colorProperties.forEach((property) => {
              const value = computed.getPropertyValue(property);
              if (value) {
                element.style.setProperty(property, toRgba(value), "important");
              }
            });

            element.style.setProperty("box-shadow", "none", "important");
            element.style.setProperty("text-shadow", "none", "important");

            const backgroundImage = computed.backgroundImage.toLowerCase();
            if (
              backgroundImage.includes("oklch(") ||
              backgroundImage.includes("oklab(")
            ) {
              element.style.setProperty(
                "background-image",
                "none",
                "important",
              );
            }
          });
      };

      const initializeReport = async () => {
        const draft = readFormDraft();
        const hasAnswers = draft && Object.keys(draft.answers).length > 0;

        if (!report || !draft || !hasAnswers) {
          if (loading) loading.hidden = true;
          if (empty) empty.hidden = false;
          return;
        }

        const answers = normalizeAnswers(draft.answers);
        const facts = deriveReportFacts(answers);
        const model = buildReportModel(answers, facts);

        setText("[data-report-title]", model.title);
        setText("[data-report-subtitle]", model.subtitle);
        setText("[data-report-email]", model.clientEmail);
        setText("[data-report-date]", model.generatedAt);
        setText("[data-report-version]", model.version);
        const pages = report.querySelector<HTMLElement>("[data-report-pages]");
        if (!pages) return;

        const units: HTMLElement[] = [];
        const introduction = element(
          "section",
          "report-introduction report-flow-unit",
        );
        model.introduction.forEach((paragraph) =>
          introduction.append(
            element("p", "report-introduction__paragraph", paragraph),
          ),
        );
        const outline = element("ol", "report-outline");
        model.outline.forEach((item) =>
          outline.append(element("li", undefined, item)),
        );
        introduction.append(outline);
        units.push(introduction);

        model.sections.forEach((section) =>
          units.push(...renderSectionUnits(section)),
        );

        const disclaimer = element(
          "footer",
          "report-disclaimer report-block report-flow-unit",
        );
        disclaimer.append(
          element("p", "report-overline", "Aviso del prototipo"),
          element("p", undefined, model.disclaimer),
        );
        units.push(disclaimer);

        report.hidden = false;
        report.classList.add("report-document--paginating");
        await document.fonts.ready;
        await new Promise<void>((resolve) =>
          requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
        );
        paginateFlowUnits(pages, units);
        report.classList.remove("report-document--paginating");
        if (loading) loading.hidden = true;
        if (downloadButton) downloadButton.disabled = false;
      };

      downloadButton?.addEventListener("click", async () => {
        if (!report || report.hidden || !downloadButton) return;

        downloadButton.disabled = true;
        downloadButton.textContent = "Generando…";
        if (downloadMessage) {
          downloadMessage.dataset.error = "false";
          downloadMessage.textContent =
            "Preparando el documento. Esto puede tardar unos segundos.";
        }

        try {
          await document.fonts.ready;
          report.classList.add("report-document--pdf");
          await new Promise<void>((resolve) =>
            requestAnimationFrame(() => resolve()),
          );
          const { default: html2pdf } = await import("html2pdf.js");
          const { jsPDF } = await import("jspdf");
          const mobile = window.matchMedia("(max-width: 700px)").matches;
          const captureOptions = {
            image: { type: "jpeg" as const, quality: 0.96 },
            html2canvas: {
              scale: mobile ? 1.25 : 2,
              useCORS: true,
              backgroundColor: "#ffffff",
              logging: false,
              windowWidth: 794,
              onclone: sanitizePdfClone,
            },
          };

          const pages = [
            ...report.querySelectorAll<HTMLElement>(".report-page"),
          ];
          const pdf = new jsPDF({
            unit: "mm",
            format: "a4",
            orientation: "portrait",
          });

          for (const [index, page] of pages.entries()) {
            const worker = html2pdf()
              .set(captureOptions)
              .from(page)
              .toCanvas();
            const canvas = await worker.get("canvas");
            if (index > 0) pdf.addPage("a4", "portrait");
            pdf.addImage(
              canvas.toDataURL("image/jpeg", 0.96),
              "JPEG",
              0,
              0,
              210,
              297,
              undefined,
              "FAST",
            );
          }

          pdf.save("informe-planificacion-llc.pdf");
          if (downloadMessage) {
            downloadMessage.textContent = "PDF descargado correctamente.";
          }
        } catch (error) {
          console.error("No se pudo generar el PDF", error);
          if (downloadMessage) {
            downloadMessage.dataset.error = "true";
            downloadMessage.textContent =
              "No se pudo generar el PDF. Intenta nuevamente desde este navegador.";
          }
        } finally {
          report.classList.remove("report-document--pdf");
          downloadButton.disabled = false;
          downloadButton.textContent = "Descargar PDF";
        }
      });

      completeButton?.addEventListener("click", () => {
        clearFormDraft();
        const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
        window.location.assign(baseUrl);
      });

      void initializeReport();
    </script>
  </body>
</html>
