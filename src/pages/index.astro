---
import Layout from "../layouts/Layout.astro";
import Stepper, { type StepperStep } from "@/components/blocks/stepper.astro";
import { Checkbox } from "@/components/starwind/checkbox";
import { Form } from "@/components/starwind/form";
import {
  Field,
  FieldContent,
  FieldControl,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldItem,
  FieldLabel,
} from "@/components/starwind/field";

import StepOne from "@components/forms/StepOne.astro";
import StepTwo from "@components/forms/StepTwo.astro";
import StepTree from "@components/forms/Steptree.astro";
import StepFour from "@components/forms/StepFour.astro"
import StepFive from "@components/forms/StepFive.astro";
import StepSix from "@components/forms/StepSix.astro";
import StepSeven from "@components/forms/StepSeven.astro";
import StepEight from "@components/forms/StepseEight.astro";
import StepNine from "@components/forms/StepNine.astro";
import StepTen from "@components/forms/StepTen.astro";

const steps: StepperStep[] = [
  { id: "Correo", title: "Inicio", description: "" },
  {
    id: "Modelo",
    title: "Modelo de negocio",
    description: "",
  },
  { id: "Operacion", title: "Confirmación", description: "" },
  { id: "Confidencialidad", title: "Confidencialidad", description: ""},
  { id: "Estado", title: "Estado", description: "" },
  { id: "Tributacion", title: "Tributación", description: ""},
  { id: "Estructura", title: "Estructura", description: ""},
  { id: "Administracion", title: "Administración", description: ""},
  { id: "Contabilidad", title: "Método contable", description: ""},
  { id: "Actividad", title: "Actividad económica", description: ""},
  { id: "review", title: "Final", description: ""},
];

---

<Layout>
  <div class="mx-auto w-full max-w-7xl px-4 py-10">
    <Form
      data-llc-form
      validationTiming="manual"
      revalidationTiming="manual"
      errorVisibility="manual"
    >
      <Stepper
        steps={steps}
        defaultValue="Correo"
        label="Alta de cuenta"
        orientation="horizontal"
        nextLabel="Siguiente"
        finishLabel="Finalizar"
      >
        <StepOne slot="Correo"/>
        <StepTwo slot="Modelo"/>
        <StepTree slot="Operacion" />
        <StepFour slot="Confidencialidad" />
        <StepFive slot="Estado" />
        <StepSix slot="Tributacion" />
        <StepSeven slot="Estructura" />
        <StepEight slot="Administracion" />
        <StepNine slot="Contabilidad" />
        <StepTen slot="Actividad" />

        <div slot="review">
          <FieldGroup>
            <div class="text-muted-foreground space-y-2 text-sm">
              <p class="text-foreground font-medium">Listo para confirmar.</p>
              <p>
                Revisa los pasos anteriores y acepta las condiciones para
                finalizar.
              </p>
            </div>

            <Field name="terms" orientation="horizontal">
              <FieldItem>
                <Checkbox
                  id="terms"
                  name="terms"
                  value="accepted"
                  aria-label="Aceptar los términos y condiciones"
                  required
                />
                <FieldContent>
                  <FieldLabel for="terms"
                    >Acepto los términos y condiciones</FieldLabel
                  >
                  <FieldDescription>
                    Este checkbox es obligatorio para completar el stepper.
                  </FieldDescription>
                </FieldContent>
              </FieldItem>
              <FieldError match="valueMissing">
                Debes aceptar los términos para continuar.
              </FieldError>
            </Field>
          </FieldGroup>
        </div>
      </Stepper>
    </Form>

    <script>
      import { createForm } from "@starwind-ui/astro/form";
      import { createCheckbox } from "@starwind-ui/runtime/checkbox";
      import { createCombobox } from "@starwind-ui/runtime/combobox";
      import { createSelect } from "@starwind-ui/runtime/select";
      import { createSwitch } from "@starwind-ui/runtime/switch";
      import { createTabs } from "@starwind-ui/runtime/tabs";
      import {
        clearFormDraft,
        persistedFieldNames,
        readFormDraft,
        writeFormDraft,
        type FormDraft,
        type FormDraftAnswers,
        type FormDraftProgress,
        type PersistedFieldName,
      } from "@/components/forms/form-draft";

      const multipleDraftFields = new Set<PersistedFieldName>([
        "clientMarkets",
        "operationalIndicators",
      ]);

      const radioGroupIds: Partial<Record<PersistedFieldName, string>> = {
        businessModel: "business-model-group",
        confidentialityLevel: "confidentiality-level-group",
        operaciones: "operaciones-group",
        hasUsSourceIncome: "tributacion-model-group",
        llcTaxTreatment: "llc-tax-treatment-group",
        EstructureClassLevel: "EstructureClass-level-group",
        singleMemberOwnerType: "TypeOfSinglemember-level-group",
        numberOfMembers: "NumberOfPartnership-level-group",
        sistemModel: "sistem-model-group",
        cashModel: "cash-model-group",
      };

      const comboboxSelectors: Partial<Record<PersistedFieldName, string>> = {
        formationState: "[data-formation-state-combobox]",
        primaryOperatingCountry: "[data-primary-operating-country]",
        primaryEconomicActivity: "[data-primary-economic-activity]",
      };

      const stepFields: Record<string, string[]> = {
        Correo: ["email"],
        Modelo: [],
        Operacion: [
          "operationDescription",
          "projectedAnnualRevenue",
        ],
        Confidencialidad: [],
        Estado: ["formationState"],
        Tributacion: ["primaryOperatingCountry"],
        Estructura: [],
        Administracion: [],
        Contabilidad: [],
        Actividad: ["primaryEconomicActivity"],
        review: ["terms"],
      };

      const standaloneGroups: Record<
        string,
        Array<{
          errorId: string;
          kind: "checkbox" | "radio";
          rootId: string;
        }>
      > = {
        Modelo: [
          {
            errorId: "business-model-error",
            kind: "radio",
            rootId: "business-model-group",
          },
        ],
        Operacion: [
          {
            errorId: "client-markets-error",
            kind: "checkbox",
            rootId: "client-markets-group",
          },
        ],
        Confidencialidad: [
          {
            errorId: "confidentiality-level-error",
            kind: "radio",
            rootId: "confidentiality-level-group",
          },
        ],
        Estado: [
          {
            errorId: "operations-error",
            kind: "radio",
            rootId: "operaciones-group",
          },
        ],
        Tributacion: [
          {
            errorId: "tributacion-model-error",
            kind: "radio",
            rootId: "tributacion-model-group",
          },
          {
            errorId: "llc-tax-treatment-error",
            kind: "radio",
            rootId: "llc-tax-treatment-group",
          },
        ],
        Estructura: [
          {
            errorId: "EstructureClass-level-error",
            kind: "radio",
            rootId: "EstructureClass-level-group",
          },
          {
            errorId: "TypeOfSinglemember-level-error",
            kind: "radio",
            rootId: "TypeOfSinglemember-level-group",
          },
          {
            errorId: "NumberOfPartnership-level-error",
            kind: "radio",
            rootId: "NumberOfPartnership-level-group",
          },
        ],
        Administracion: [
          {
            errorId: "sistem-model-error",
            kind: "radio",
            rootId: "sistem-model-group",
          },
        ],
        Contabilidad: [
          {
            errorId: "cash-model-error",
            kind: "radio",
            rootId: "cash-model-group",
          },
        ],
      };

      const setupLlcForm = (form: HTMLFormElement) => {
        if (form.dataset.llcFormReady === "true") return;
        form.dataset.llcFormReady = "true";

        const stepperRoot = form.querySelector<HTMLElement>("[data-stepper]");
        const list = stepperRoot?.querySelector<HTMLElement>(
          '[data-slot="tabs-list"]',
        );
        const triggers = Array.from(
          list?.querySelectorAll<HTMLButtonElement>(
            '[data-slot="tabs-trigger"]',
          ) ?? [],
        );
        const previousButton = stepperRoot?.querySelector<HTMLButtonElement>(
          "[data-stepper-prev]",
        );
        const nextButton = stepperRoot?.querySelector<HTMLButtonElement>(
          "[data-stepper-next]",
        );
        const nextLabel = stepperRoot?.querySelector<HTMLElement>(
          "[data-stepper-next-label]",
        );
        const finishLabel = stepperRoot?.querySelector<HTMLElement>(
          "[data-stepper-finish-label]",
        );

        if (
          !stepperRoot ||
          !list ||
          triggers.length === 0 ||
          !previousButton ||
          !nextButton
        )
          return;

        const authoredDisabled = triggers.map((trigger) => trigger.disabled);
        const completed = new Set<number>();
        const tabsApi = createTabs(stepperRoot);
        let highestUnlocked = 0;
        let busy = false;
        let persistenceSuspended = true;
        let draftDirty = false;
        let draftSaveTimer: number | undefined;

        const activeIndex = () => {
          const index = triggers.findIndex(
            (trigger) => trigger.dataset.state === "active",
          );
          return index < 0 ? 0 : index;
        };

        const nextAvailableIndex = (from: number, direction: 1 | -1) => {
          for (
            let index = from + direction;
            index >= 0 && index < triggers.length;
            index += direction
          ) {
            if (!authoredDisabled[index]) return index;
          }
          return -1;
        };

        const sync = () => {
          const active = activeIndex();
          const next = nextAvailableIndex(active, 1);

          triggers.forEach((trigger, index) => {
            const locked = authoredDisabled[index] || index > highestUnlocked;
            trigger.disabled = locked;
            trigger.toggleAttribute("data-disabled", locked);
            trigger.setAttribute("aria-disabled", String(locked));
            trigger.toggleAttribute("data-completed", completed.has(index));
            if (index === active) {
              trigger.setAttribute("aria-current", "step");
            } else {
              trigger.removeAttribute("aria-current");
            }

            trigger
              .querySelector("[data-stepper-connector]")
              ?.toggleAttribute("data-completed", completed.has(index));
          });

          previousButton.disabled = busy || nextAvailableIndex(active, -1) < 0;
          nextButton.disabled = busy;
          nextButton.setAttribute("aria-busy", String(busy));
          nextLabel?.classList.toggle("hidden", next < 0);
          finishLabel?.classList.toggle("hidden", next >= 0);
        };

        const goTo = (index: number, focus = false) => {
          const target = triggers[index];
          const value = target?.dataset.value;
          if (!target || !value || authoredDisabled[index]) return;

          tabsApi.setValue(value, { emit: true });
          queueMicrotask(() => {
            sync();
            if (focus) target.focus();
          });
        };

        const validateComboboxSelection = (
          selector: string,
          message: string,
        ) => {
          const root = form.querySelector<HTMLElement>(selector);
          const hiddenInput = root?.querySelector<HTMLInputElement>(
            "[data-sw-combobox-hidden-input]",
          );
          const visibleInput = root?.querySelector<HTMLInputElement>(
            '[data-slot="combobox-input"]',
          );
          const selectedValue = hiddenInput?.value.trim();

          // The required hidden input reports valueMissing while no option is
          // selected, including when the user has only typed filter text.
          if (!selectedValue) return null;

          const selectedItem = Array.from(
            root?.querySelectorAll<HTMLElement>(
              '[data-slot="combobox-item"]',
            ) ?? [],
          ).find((item) => item.dataset.value === selectedValue);
          const selectedLabel = selectedItem
            ?.querySelector<HTMLElement>('[data-slot="combobox-item-text"]')
            ?.textContent?.trim();

          if (!selectedLabel || visibleInput?.value.trim() === selectedLabel) {
            return null;
          }

          return {
            key: "customError" as const,
            message,
            source: "custom" as const,
          };
        };

        const collectDraftAnswers = (): FormDraftAnswers => {
          const formData = new FormData(form);
          const answers: FormDraftAnswers = {};

          persistedFieldNames.forEach((fieldName) => {
            const values = formData
              .getAll(fieldName)
              .filter((value): value is string => typeof value === "string")
              .filter((value) => value.trim().length > 0);

            if (multipleDraftFields.has(fieldName)) {
              if (values.length > 0) {
                answers[fieldName] = Array.from(new Set(values));
              }
              return;
            }

            const value = values[0];
            if (value) answers[fieldName] = value;
          });

          return answers;
        };

        const captureDraftProgress = (): FormDraftProgress => ({
          currentStep: triggers[activeIndex()]?.dataset.value ?? "Correo",
          highestUnlockedStep:
            triggers[highestUnlocked]?.dataset.value ?? "Correo",
          completedSteps: Array.from(completed)
            .sort((a, b) => a - b)
            .map((index) => triggers[index]?.dataset.value)
            .filter((value): value is string => Boolean(value)),
        });

        const saveDraft = (force = false) => {
          if (persistenceSuspended || (!force && !draftDirty)) return;
          writeFormDraft(collectDraftAnswers(), captureDraftProgress());
          draftDirty = false;
        };

        const scheduleDraftSave = () => {
          if (persistenceSuspended) return;
          draftDirty = true;
          if (draftSaveTimer !== undefined) window.clearTimeout(draftSaveTimer);
          draftSaveTimer = window.setTimeout(() => {
            draftSaveTimer = undefined;
            saveDraft();
          }, 120);
        };

        const formApi = createForm(form, {
          fieldValidators: {
            formationState: () =>
              validateComboboxSelection(
                "[data-formation-state-combobox]",
                "Selecciona un estado disponible para continuar.",
              ),
            primaryOperatingCountry: () =>
              validateComboboxSelection(
                "[data-primary-operating-country]",
                "Selecciona el país principal de operación.",
              ),
            primaryEconomicActivity: () =>
              validateComboboxSelection(
                "[data-primary-economic-activity]",
                "Selecciona una actividad económica disponible.",
              ),
          },
          onSubmit: ({ form: submittedForm, values }) => {
            completed.add(activeIndex());
            sync();
            saveDraft(true);
            submittedForm.dispatchEvent(
              new CustomEvent("llc-form:submit", {
                bubbles: true,
                detail: {
                  formData: new FormData(submittedForm),
                  values,
                },
              }),
            );
          },
        });

        const nextFrame = () =>
          new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

        const draftString = (
          draft: FormDraft,
          fieldName: PersistedFieldName,
        ) => {
          const value = draft.answers[fieldName];
          return typeof value === "string" ? value : undefined;
        };

        const draftStrings = (
          draft: FormDraft,
          fieldName: PersistedFieldName,
        ) => {
          const value = draft.answers[fieldName];
          return Array.isArray(value) ? value : [];
        };

        const restoreNativeField = (
          draft: FormDraft,
          fieldName: "email" | "operationDescription",
          selector: string,
        ) => {
          const value = draftString(draft, fieldName);
          const control = form.querySelector<
            HTMLInputElement | HTMLTextAreaElement
          >(selector);
          if (!value || !control) return;

          control.value = value;
          control.dispatchEvent(new Event("input", { bubbles: true }));
          control.dispatchEvent(new Event("change", { bubbles: true }));
        };

        const restoreRadioGroup = (
          draft: FormDraft,
          fieldName: PersistedFieldName,
        ) => {
          const value = draftString(draft, fieldName);
          const rootId = radioGroupIds[fieldName];
          if (!value || !rootId) return;

          const root = form.querySelector<HTMLElement>(`#${rootId}`);
          if (!root || root.dataset.value === value) return;

          Array.from(
            root.querySelectorAll<HTMLElement>(
              '[data-slot="radio-group-item"]',
            ),
          )
            .find((item) => item.dataset.value === value)
            ?.click();
        };

        const restoreCheckboxes = (
          draft: FormDraft,
          fieldName: "clientMarkets",
        ) => {
          const selectedValues = new Set(draftStrings(draft, fieldName));

          form
            .querySelectorAll<HTMLElement>('[data-slot="checkbox"]')
            .forEach((root) => {
              const input = root.querySelector<HTMLInputElement>(
                `input[name="${fieldName}"]`,
              );
              if (!input) return;
              createCheckbox(root).setChecked(
                selectedValues.has(input.value),
                { emit: true },
              );
            });
        };

        const restoreSwitches = (
          draft: FormDraft,
          fieldName: "operationalIndicators",
        ) => {
          const selectedValues = new Set(draftStrings(draft, fieldName));

          form
            .querySelectorAll<HTMLElement>('[data-slot="switch-button"]')
            .forEach((root) => {
              if (root.dataset.name !== fieldName || !root.dataset.value) return;
              createSwitch(root).setChecked(
                selectedValues.has(root.dataset.value),
                { emit: true },
              );
            });
        };

        const restoreSelect = (
          draft: FormDraft,
          fieldName: "projectedAnnualRevenue",
          selector: string,
        ) => {
          const value = draftString(draft, fieldName);
          const root = form.querySelector<HTMLElement>(selector);
          if (!value || !root) return;
          createSelect(root).setValue(value, { emit: true });
        };

        const restoreCombobox = (
          draft: FormDraft,
          fieldName:
            | "formationState"
            | "primaryOperatingCountry"
            | "primaryEconomicActivity",
        ) => {
          const value = draftString(draft, fieldName);
          const selector = comboboxSelectors[fieldName];
          const root = selector
            ? form.querySelector<HTMLElement>(selector)
            : null;
          if (!value || !root) return;
          createCombobox(root).setValue(value, { emit: true });
        };

        const restoreDraftProgress = (draft: FormDraft) => {
          const stepIndex = (stepId: string) =>
            triggers.findIndex((trigger) => trigger.dataset.value === stepId);

          const storedCurrent = stepIndex(draft.progress.currentStep);
          const storedHighest = stepIndex(draft.progress.highestUnlockedStep);
          const current = storedCurrent >= 0 ? storedCurrent : 0;
          const highest = Math.max(
            0,
            current,
            storedHighest >= 0 ? storedHighest : 0,
          );

          highestUnlocked = Math.min(highest, triggers.length - 1);
          completed.clear();
          draft.progress.completedSteps.forEach((stepId) => {
            const index = stepIndex(stepId);
            if (
              index >= 0 &&
              index <= highestUnlocked &&
              !authoredDisabled[index]
            ) {
              completed.add(index);
            }
          });

          sync();
          goTo(Math.min(current, highestUnlocked));
        };

        const restoreDraft = async (draft: FormDraft) => {
          await nextFrame();

          restoreNativeField(draft, "email", '#email');
          restoreNativeField(
            draft,
            "operationDescription",
            '#operation-description',
          );
          restoreSelect(
            draft,
            "projectedAnnualRevenue",
            "#projected-annual-revenue",
          );
          restoreRadioGroup(draft, "businessModel");
          restoreCheckboxes(draft, "clientMarkets");

          restoreRadioGroup(draft, "confidentialityLevel");
          await nextFrame();
          restoreCombobox(draft, "formationState");
          restoreRadioGroup(draft, "operaciones");

          restoreCombobox(draft, "primaryOperatingCountry");
          restoreRadioGroup(draft, "hasUsSourceIncome");
          restoreRadioGroup(draft, "llcTaxTreatment");
          await nextFrame();
          if (draftString(draft, "hasUsSourceIncome") === "true") {
            restoreSwitches(draft, "operationalIndicators");
          }

          restoreRadioGroup(draft, "EstructureClassLevel");
          await nextFrame();
          const structure = draftString(draft, "EstructureClassLevel");
          if (structure === "Single Member") {
            restoreRadioGroup(draft, "singleMemberOwnerType");
          } else if (structure === "Partnership") {
            restoreRadioGroup(draft, "numberOfMembers");
          }

          restoreRadioGroup(draft, "sistemModel");
          restoreRadioGroup(draft, "cashModel");
          restoreCombobox(draft, "primaryEconomicActivity");

          restoreDraftProgress(draft);
        };

        const initializeDraftPersistence = async () => {
          const draft = readFormDraft();

          try {
            if (draft) await restoreDraft(draft);
          } finally {
            persistenceSuspended = false;
          }

          // Rewrites migrated or sanitized data using the current schema.
          if (draft) saveDraft(true);
        };

        const isStandaloneGroupValid = (
          group: (typeof standaloneGroups)[string][number],
        ) => {
          const root = form.querySelector<HTMLElement>(`#${group.rootId}`);
          if (!root) return false;
          if (root.closest("[hidden]")) return true;

          return group.kind === "radio"
            ? Boolean(root.dataset.value)
            : Boolean(
                root.querySelector('[data-slot="checkbox"][data-checked]'),
              );
        };

        const setStandaloneGroupValidity = (
          group: (typeof standaloneGroups)[string][number],
          valid: boolean,
        ) => {
          const root = form.querySelector<HTMLElement>(`#${group.rootId}`);
          const error = form.querySelector<HTMLElement>(`#${group.errorId}`);
          root?.setAttribute("aria-invalid", String(!valid));
          if (error) error.hidden = valid;
        };

        const validateStandaloneGroups = (stepId: string) => {
          const groups = standaloneGroups[stepId] ?? [];
          let firstInvalid: HTMLElement | null = null;

          groups.forEach((group) => {
            const valid = isStandaloneGroupValid(group);
            setStandaloneGroupValidity(group, valid);
            if (!valid && !firstInvalid) {
              firstInvalid = form.querySelector<HTMLElement>(
                `#${group.rootId} [data-slot="radio-group-item"], #${group.rootId} [data-slot="checkbox"]`,
              );
            }
          });

          firstInvalid?.focus();
          return firstInvalid === null;
        };

        const advance = async () => {
          if (busy) return;

          const current = activeIndex();
          const next = nextAvailableIndex(current, 1);
          if (next < 0) {
            form.requestSubmit();
            return;
          }

          busy = true;
          sync();

          try {
            const stepId = triggers[current]?.dataset.value ?? "";
            if (!validateStandaloneGroups(stepId)) return;

            const outcome = await formApi.validate({
              names: stepFields[stepId] ?? [],
              reveal: true,
              focus: true,
            });

            if (outcome.status !== "complete" || !outcome.valid) return;

            completed.add(current);
            highestUnlocked = Math.max(highestUnlocked, next);
            sync();
            goTo(next, true);
          } finally {
            busy = false;
            sync();
          }
        };

        const invalidateActiveStep = (event: Event) => {
          if (persistenceSuspended) return;
          if (!(event.target instanceof Element)) return;
          const panel = event.target.closest<HTMLElement>(
            '[data-slot="tabs-content"][data-state="active"]',
          );
          if (!panel) return;

          const current = activeIndex();
          completed.forEach((index) => {
            if (index >= current) completed.delete(index);
          });
          highestUnlocked = Math.min(highestUnlocked, current);
          sync();

          const stepId = triggers[current]?.dataset.value ?? "";
          queueMicrotask(() => {
            (standaloneGroups[stepId] ?? []).forEach((group) => {
              const root = form.querySelector<HTMLElement>(`#${group.rootId}`);
              if (root?.contains(event.target as Node) && isStandaloneGroupValid(group)) {
                setStandaloneGroupValidity(group, true);
              }
            });
          });
        };

        const handleFormMutation = (event: Event) => {
          invalidateActiveStep(event);
          scheduleDraftSave();
        };

        previousButton.addEventListener("click", () => {
          if (busy) return;
          const previous = nextAvailableIndex(activeIndex(), -1);
          if (previous >= 0) goTo(previous, true);
        });
        nextButton.addEventListener("click", () => void advance());
        list.addEventListener("click", (event) => {
          if (!busy) return;
          event.preventDefault();
          event.stopImmediatePropagation();
        }, true);
        list.addEventListener("keydown", (event) => {
          if (!busy) return;
          event.preventDefault();
          event.stopImmediatePropagation();
        }, true);

        form.addEventListener("input", handleFormMutation);
        form.addEventListener("change", handleFormMutation);
        form.addEventListener("starwind:value-change", handleFormMutation);
        form.addEventListener("starwind:checked-change", handleFormMutation);
        stepperRoot.addEventListener("starwind:value-change", (event) => {
          if (event.target !== stepperRoot) return;
          queueMicrotask(() => {
            sync();
            scheduleDraftSave();
          });
        });
        form.addEventListener("reset", () => {
          persistenceSuspended = true;
          draftDirty = false;
          if (draftSaveTimer !== undefined) {
            window.clearTimeout(draftSaveTimer);
            draftSaveTimer = undefined;
          }
          clearFormDraft();

          window.setTimeout(() => {
            completed.clear();
            highestUnlocked = 0;
            goTo(0, true);
            sync();
            form.dispatchEvent(
              new CustomEvent("llc-form:reset", { bubbles: true }),
            );
            requestAnimationFrame(() => {
              persistenceSuspended = false;
            });
          }, 0);
        });

        window.addEventListener("pagehide", () => saveDraft());

        sync();
        void initializeDraftPersistence();
      };

      const initLlcForms = () => {
        document
          .querySelectorAll<HTMLFormElement>("[data-llc-form]")
          .forEach(setupLlcForm);
      };

      initLlcForms();
      document.addEventListener("astro:page-load", initLlcForms);
    </script>
  </div>
</Layout>
