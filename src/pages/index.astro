---
import Layout from "../layouts/Layout.astro";
import Stepper, { type StepperStep } from "@/components/blocks/stepper.astro";
import { Checkbox } from "@/components/starwind/checkbox";
import { Form } from "@/components/starwind/form";
import {
  Field,
  FieldContent,
  FieldControl,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldItem,
  FieldLabel,
} from "@/components/starwind/field";

import StepOne from "@components/forms/StepOne.astro";
import StepTwo from "@components/forms/StepTwo.astro";
import StepTree from "@components/forms/Steptree.astro";
import StepFour from "@components/forms/StepFour.astro"
import StepFive from "@components/forms/StepFive.astro";

const steps: StepperStep[] = [
  { id: "Correo", title: "Inicio", description: "" },
  {
    id: "Modelo",
    title: "Modelo de negocio",
    description: "",
  },
  { id: "Operacion", title: "Confirmación", description: "" },
  { id: "Confidencialidad", title: "Confidencialidad", description: ""},
  { id: "Estado", title: "Estado", description: "" },
  { id: "review", title: "Final", description: ""},
];

---

<Layout>
  <div class="mx-auto w-full max-w-7xl px-4 py-10">
    <Form
      data-llc-form
      validationTiming="manual"
      revalidationTiming="manual"
      errorVisibility="manual"
    >
      <Stepper
        steps={steps}
        defaultValue="Correo"
        label="Alta de cuenta"
        orientation="horizontal"
        nextLabel="Siguiente"
        finishLabel="Finalizar"
      >
        <StepOne slot="Correo"/>
        <StepTwo slot="Modelo"/>
        <StepTree slot="Operacion" />
        <StepFour slot="Confidencialidad" />
        <StepFive slot="Estado" />

        <div slot="review">
          <FieldGroup>
            <div class="text-muted-foreground space-y-2 text-sm">
              <p class="text-foreground font-medium">Listo para confirmar.</p>
              <p>
                Revisa los pasos anteriores y acepta las condiciones para
                finalizar.
              </p>
            </div>

            <Field name="terms" orientation="horizontal">
              <FieldItem>
                <Checkbox
                  id="terms"
                  name="terms"
                  value="accepted"
                  aria-label="Aceptar los términos y condiciones"
                  required
                />
                <FieldContent>
                  <FieldLabel for="terms"
                    >Acepto los términos y condiciones</FieldLabel
                  >
                  <FieldDescription>
                    Este checkbox es obligatorio para completar el stepper.
                  </FieldDescription>
                </FieldContent>
              </FieldItem>
              <FieldError match="valueMissing">
                Debes aceptar los términos para continuar.
              </FieldError>
            </Field>
          </FieldGroup>
        </div>
      </Stepper>
    </Form>

    <script>
      import { createForm } from "@starwind-ui/astro/form";

      const form = document.querySelector<HTMLFormElement>("[data-llc-form]");
      const formApi = form
        ? createForm(form, {
            fieldValidators: {
              clientMarkets: (_value, { field }) => {
                const hasSelection = Boolean(
                  field.root.querySelector("[data-sw-checkbox][data-checked]"),
                );

                return hasSelection
                  ? null
                  : {
                      key: "customError",
                      message:
                        "Selecciona al menos un mercado donde tendrás clientes.",
                      source: "custom",
                    };
              },
              formationState: () => {
                const root = document.querySelector<HTMLElement>(
                  "[data-formation-state-combobox]",
                );
                const selected = root?.dataset.value;
                const label = root
                  ?.querySelector<HTMLInputElement>(
                    '[data-slot="combobox-input"]',
                  )
                  ?.value.trim();

                return selected && label === selected
                  ? null
                  : {
                      key: "customError",
                      message:
                        "Selecciona un estado disponible para continuar.",
                      source: "custom",
                    };
              },
            },
          })
        : null;

      const stepFields: Record<string, string[]> = {
        Correo: ["email"],
        Modelo: ["businessModel"],
        Operacion: [
          "operationDescription",
          "projectedAnnualRevenue",
          "clientMarkets",
        ],
        Confidencialidad: ["confidentialityLevel"],
        Estado: ["formationState", "operaciones"],
        review: ["terms"],
      };

      const stepperRoot = document.querySelector<HTMLElement>("[data-stepper]");
      const nextButton = stepperRoot?.querySelector<HTMLButtonElement>(
        "[data-stepper-next]",
      );

      const currentStepId = () =>
        stepperRoot
          ?.querySelector<HTMLButtonElement>(
            '[data-slot="tabs-trigger"][data-state="active"]',
          )
          ?.getAttribute("value") ?? "Correo";

      const requestStepValidation = async (target?: HTMLButtonElement) => {
        if (!formApi) return true;

        const activeStep = currentStepId();
        const names = stepFields[activeStep] ?? [];

        const outcome = await formApi.validate({
          names,
          reveal: true,
          focus: true,
        });

        if (outcome.status !== "complete" || !outcome.valid) return false;

        if (target) {
          target.dataset.skipStepValidation = "true";
          target.click();
          queueMicrotask(() => {
            delete target.dataset.skipStepValidation;
          });
        }

        return true;
      };

      const guardClick = (
        target: HTMLButtonElement | undefined,
        event: MouseEvent,
      ) => {
        if (!target || target.dataset.skipStepValidation === "true") return;

        event.preventDefault();
        event.stopPropagation();
        void requestStepValidation(target);
      };

      stepperRoot
        ?.querySelectorAll<HTMLButtonElement>('[data-slot="tabs-trigger"]')
        .forEach((trigger) => {
          trigger.addEventListener("click", (event) => guardClick(trigger, event), true);
        });

      nextButton?.addEventListener("click", (event) => guardClick(nextButton, event), true);
    </script>
  </div>
</Layout>
