---
import "@/styles/starwind.css";
import Navbar, { type NavLink } from "@components/blocks/Navbar.astro";
import { Toaster } from "@/components/starwind/toast";

const links: NavLink[] = [
  { label: "Features", href: "#features" },
  { label: "Pricing", href: "#pricing" },
  { label: "About", href: "#about" },
  { label: "Blog", href: "#blog" },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="m-0 w-full h-full">
		<Navbar Logo="LogoSCIwhite" links={links} ctaText="Get Started" ctaHref="#get-started" />
		<slot />
		<Toaster position="top-right" />
	</body>
</html>

